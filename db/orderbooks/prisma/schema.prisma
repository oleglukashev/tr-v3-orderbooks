generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.db/orderbooks/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("ORDERBOOKS_DATABASE_URL")
}

generator dbml {
  provider = "prisma-dbml-generator"
}

model Orderbook {
  id   String @id @unique @default(uuid())
  ts   BigInt
  tf   Int    @default(1)
  data Json   @default("{}")
  v    Int    @default(0)

  pairId Int @map("pair_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([ts, tf, pairId])
  @@index([pairId])
  @@map("orderbooks")
}
